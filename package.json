{
  "name": "monster-speller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "กองกำลังพิทักษ์ตัวสะกด (Monster Speller) — เกมยิงมอนสเตอร์เรียนรู้มาตราตัวสะกดภาษาไทย",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:assets && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc --noEmit",
    "check:assets": "node scripts/check-assets.mjs"
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.1"
  }
}
